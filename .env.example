# API Configuration
# Base URL every request is prefixed with. Keep it as /api to go through the
# Vite dev proxy (avoids CORS during development), or set an absolute URL
# such as https://api.staging.example.com to call the backend directly.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api/* requests (only used by `npm run dev`).
# Point to your backend API server.
VITE_API_PROXY_TARGET=http://localhost:5000
